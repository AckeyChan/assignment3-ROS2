<?xml version="1.0"?>
<package format="3">
  <name>hikrobot_camera</name>
  <version>0.1.0</version>
  <description>ROS 2 driver for HIKROBOT machine vision cameras based on the MVS SDK.</description>
  <!-- Replace placeholder maintainer and choose a license before publishing. -->
  <maintainer email="student@example.com">Student Name</maintainer>
  <license>TODO</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- 厂商 SDK（MVS）不在 rosdep 中，安装要求见 README。 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
